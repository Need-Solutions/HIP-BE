NODE_ENV=development
PORT=5001
# Controllers 4–6 require MongoDB transactions: use Atlas or a replica set (single node is fine locally).
# For local rs0, start mongod with --replSet rs0, then initialize it once with rs.initiate().
# Existing standalone databases must be converted deliberately; do not initialize/drop application data in tests.
MONGODB_URI=mongodb://127.0.0.1:27017/hip?replicaSet=rs0
CLIENT_URL=http://localhost:5173
# Required: generate a private value with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
# Required, independent of JWT_SECRET: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Keep this key stable: it encrypts authenticator secrets, event signing keys and delivery payloads.
ENCRYPTION_KEY=
# Set all three to create the first super admin at startup; leave all empty to skip seeding.
# Password: at least 8 characters, one number, one symbol, at most 72 UTF-8 bytes.
# Existing accounts are never overwritten by the seeder.
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_NAME=
SUPER_ADMIN_PASSWORD=
# Local SMTP catcher (e.g. Mailpit); use your provider's settings when deploying.
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
# Set both for authenticated SMTP. Port 465 enables implicit TLS.
SMTP_USER=
SMTP_PASS=
# Accepts a bare email or a named sender, e.g. MAIL_FROM="HIP <hip@example.com>".
MAIL_FROM=hip@example.com
# Controller 5 covers: set all three privately. Leave all empty to disable uploads (503).
# Other event routes remain available without Cloudinary. Never put these in frontend VITE_ settings.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Controller 6: Paystack secret key, server only. Use sk_test_ credentials for Postman/tests.
# Leave empty to disable paid checkout (503); free orders still work. Never expose it through VITE_.
PAYSTACK_SECRET_KEY=
# Defaults for the singleton DB settings. Once saved, change them in Super admin > Payments & settlement.
# No rate is assumed: leave blank until the super admin saves a positive percentage (up to 2 decimals).
# Paid checkout needs both a positive percentage and a verified group subaccount; free orders still work.
PLATFORM_FEE_PERCENT=
PLATFORM_FEE_MODE=added_to_buyer
PLATFORM_FEE_ON_REFUND=refund
PAYSTACK_FEE_BEARER=hiker
# Optional, DEVELOPMENT ONLY. Omit entirely in production (startup rejects it).
# Leave unset for random codes; enable only for repeatable development tests.
# DEV_FIXED_CODE=123456
